# =====================================================================================
# Padrões do projeto (commitados). Para mudar algo no seu PC, copie para .env e edite lá.
# Prioridade: variável do terminal > ENV_FILE (ex.: configs/clef-colab.env) > .env > este arquivo.
# O porquê de cada valor (com os papers) está no README.md, seção "Parâmetros".
# Escreva um valor por linha, sem comentário na mesma linha.
# =====================================================================================

# ---------------------------------------------------------------- pastas (disco D:)
# Ambiente Python, dados, modelos baixados, checkpoints e dados do MLflow ficam aqui,
# fora do OneDrive (a Área de Trabalho sincroniza com a nuvem).
WORK_DIR=D:/laya-treino
# Vazio = WORK_DIR/runs
RUNS_DIR=
# Pasta para onde o run e o MLflow são copiados a cada época (ex.: Google Drive no Colab). Vazio = não copia
MIRROR_DIR=

# ---------------------------------------------------------------- modelo (Hugging Face)
# laya -> checkpoints no formato do Laya (tem rl_agent_config.json):
#   convaiinnovations/laya                         -> inglês, ModernBERT-large, 421M
#   convaiinnovations/laya + subfolder multilingual -> 100+ línguas, mmBERT-base, 322M
#   convaiinnovations/laya-typed-decisions         -> já ajustado em 4 fluxos de decisão
# clef -> Cloudflare/clef-flash (Qwen3.5-9B + cabeça de esquema conjunta; precisa de GPU grande)
MODEL_FAMILY=laya
HF_MODEL_ID=convaiinnovations/laya
HF_MODEL_SUBFOLDER=
# Commit ou tag para fixar a versão do modelo (vazio = main)
HF_MODEL_REVISION=
# Só necessário para repositórios privados
HF_TOKEN=
# Apaga o modelo baixado no fim do run (o checkpoint ajustado não é apagado)
DELETE_MODEL_AFTER_RUN=true

# ---------------------------------------------------------------- dataset
DATASET_ID=Tobi-Bueck/customer-support-tickets
DATASET_FILES=aa_dataset-tickets-multi-lang-5-2-50-version.csv,dataset-tickets-multi-lang-4-20k.csv
DATASET_LANGUAGE=en
LABEL_COLUMN=priority
QUESTION_ID=priority
SCORE_INSTRUCTIONS=How urgent is this customer support ticket?
# Níveis em ordem crescente (o índice 0 é o primeiro). Um texto por nível, separados por |
SCORE_LABELS=low,medium,high
SCORE_CRITERIA=low: non-urgent, such as general questions, minor inconveniences, routine updates or feature requests|medium: needs a timely fix but is not critical, such as performance problems, intermittent errors or detailed user questions|high: needs immediate attention, such as system outages, security breaches, data loss or major malfunctions
VAL_FRACTION=0.1
TEST_FRACTION=0.1
SPLIT_SEED=42
# 0 = usa tudo. Use valores pequenos (ex.: 500 / 200) para um teste rápido
MAX_TRAIN_SAMPLES=0
MAX_EVAL_SAMPLES=0

# ---------------------------------------------------------------- treino
# lora -> LoRA no encoder + cabeça inteira (cabe em 6 GB)
# head -> só a cabeça de decisão, encoder congelado (cabe em 6 GB, ganha menos)
# full -> tudo (precisa de ~16 GB, ex.: Colab T4)
TRAIN_MODE=lora
# rlcd (padrão do Laya) ou soft-ce
LOSS=rlcd
EPOCHS=4
MICRO_BATCH=8
GRAD_ACCUM=8
ENCODER_LR=2.5e-5
HEAD_LR=1e-4
MIN_LR=1e-6
WEIGHT_DECAY=0.01
GRAD_CLIP=1.0
LABEL_SMOOTHING=0.0
MAX_LEN=512
HEAD_MAX_LEN=192
AMP=true
GRADIENT_CHECKPOINTING=true
SEED=0

# RLCD: amostras por item, ruído de exploração (início -> fim) e pesos das regras de pontuação
RL_SAMPLES=4
SIGMA_START=0.4
SIGMA_END=0.1
W_SPH=0.75
W_RPS=1.0

# Calibração (temperatura) num pedaço separado do treino: min(CALIB_MAX, CALIB_FRAC * n)
CALIB_MAX=400
CALIB_FRAC=0.1
TARGET_ERROR=0.10
LOG_EVERY=100

# ---------------------------------------------------------------- loop genérico (MODEL_FAMILY=clef)
# Precisão do forward: bf16, fp16 ou fp32
DTYPE=bf16
# Fração dos passos com warmup linear antes do cosseno
WARMUP_FRACTION=0.05
# Peso do termo de Brier quando LOSS=soft-ce+brier
BRIER_WEIGHT=1.0
# Piso da temperatura ajustada (1 = só pode deixar o modelo menos confiante)
CALIB_MIN_TEMPERATURE=1.0
# Limite de tokens por registro (prompt do clef + ticket)
CLEF_MAX_LENGTH=2048
# Pasta checkpoint_latest de um run interrompido, para continuar dele
RESUME_FROM=

# ---------------------------------------------------------------- LoRA (TRAIN_MODE=lora)
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.1
LORA_LR=3e-4
# Camadas lineares do ModernBERT: atenção (Wqkv, Wo) e MLP (Wi, Wo)
LORA_TARGET_MODULES=Wqkv,Wo,Wi
# Alternativa por regex no nome completo do módulo (tem prioridade sobre a lista acima)
LORA_TARGET_REGEX=

# ---------------------------------------------------------------- avaliação
EVAL_BASELINE=true
EVAL_EVERY_EPOCH=true
EVAL_BATCH_SIZE=32
TOP_K=1,3,5,10,15,20
# Ticket "relevante" no ranking: nível >= este índice (2 = high)
RELEVANT_MIN_LEVEL=2
# prob -> ordena por P(nível >= relevante) ; expected -> ordena pelo score esperado
RANK_BY=prob
# Caixas de entrada simuladas: RANK_POOLS sorteios de RANK_POOL_SIZE tickets (0 = teste inteiro)
RANK_POOL_SIZE=100
RANK_POOLS=500
ECE_BINS=15

# ---------------------------------------------------------------- MLflow (docker compose também lê daqui)
MLFLOW_VERSION=3.17.2
MLFLOW_PORT=5000
MLFLOW_DATA_DIR=D:/laya-treino/mlflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=laya-tickets-priority
# Pasta dos artefatos ao criar o experimento (usada com MLflow em SQLite no Colab). Vazio = o servidor decide
MLFLOW_ARTIFACT_LOCATION=
# Vazio = nome automático (modelo-modo-data)
MLFLOW_RUN_NAME=
KEEP_FINETUNED_CHECKPOINT=true
# O checkpoint tem ~800 MB; só suba para o MLflow se quiser ele lá
LOG_CHECKPOINT_TO_MLFLOW=false
