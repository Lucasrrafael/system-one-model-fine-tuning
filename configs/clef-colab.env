# =====================================================================================
# Perfil: clef-flash no Colab (GPU G4, 96 GB). Usado com  ENV_FILE=configs/clef-colab.env
# Só o que muda em relação ao .env.example; o resto (dataset, métricas) vem de lá.
# O porquê de cada valor está no README.md, seção "clef-flash no Colab".
# =====================================================================================

# ---------------------------------------------------------------- pastas no Colab
WORK_DIR=/content/work
RUNS_DIR=/content/work/runs
# Google Drive montado: o run e o MLflow são copiados para cá a cada época
MIRROR_DIR=/content/drive/MyDrive/system-one

# ---------------------------------------------------------------- modelo
MODEL_FAMILY=clef
HF_MODEL_ID=Cloudflare/clef-flash
HF_MODEL_SUBFOLDER=
# Commit fixo: o joint_schema_model.py desta revisão foi lido e é o que o código espera
HF_MODEL_REVISION=fb4417d31c1d0f9e7e77f1141b40aaede7491e00
DELETE_MODEL_AFTER_RUN=true

# ---------------------------------------------------------------- treino (LoRA + cabeça)
TRAIN_MODE=lora
LOSS=rlcd
EPOCHS=2
MICRO_BATCH=8
GRAD_ACCUM=4
LORA_LR=1e-4
HEAD_LR=1e-4
MIN_LR=1e-6
WEIGHT_DECAY=0.0
WARMUP_FRACTION=0.05
GRAD_CLIP=1.0
LABEL_SMOOTHING=0.0
DTYPE=bf16
GRADIENT_CHECKPOINTING=true
CLEF_MAX_LENGTH=2048
CALIB_MIN_TEMPERATURE=1.0
LOG_EVERY=20

# ---------------------------------------------------------------- LoRA nas camadas de texto do Qwen3.5
LORA_R=32
LORA_ALPHA=64
LORA_DROPOUT=0.0
# Atenção cheia (q/k/v/o), atenção linear (in_proj_qkv, in_proj_z, out_proj) e MLP; a parte de visão fica de fora
LORA_TARGET_REGEX='model\.language_model\.layers\.\d+\.(self_attn\.(q|k|v|o)_proj|linear_attn\.(in_proj_qkv|in_proj_z|out_proj)|mlp\.(gate|up|down)_proj)'

# ---------------------------------------------------------------- avaliação
EVAL_BATCH_SIZE=16

# ---------------------------------------------------------------- MLflow local do Colab (vai para o Drive pelo MIRROR_DIR)
MLFLOW_TRACKING_URI=sqlite:////content/mlflow/mlflow.db
MLFLOW_ARTIFACT_LOCATION=/content/mlflow/artifacts
MLFLOW_EXPERIMENT=system-one-model-priority
KEEP_FINETUNED_CHECKPOINT=true
LOG_CHECKPOINT_TO_MLFLOW=false
